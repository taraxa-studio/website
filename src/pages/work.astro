---
import Base from "@/layouts/Base.astro";
import Tiles from "@/components/Tiles.astro";
import Product from "@/components/Product.astro";
import { site, novelos, sealqr } from "@/lib/site";

const schema = [
  {
    "@type": "CollectionPage",
    "@id": `${site.url}/work#page`,
    url: `${site.url}/work`,
    name: "Work",
    isPartOf: { "@id": `${site.url}/#website` },
    about: { "@id": `${site.url}/#organization` },
  },
  {
    "@type": "SoftwareApplication",
    "@id": `${novelos.url}/#app`,
    name: novelos.name,
    url: novelos.url,
    description: novelos.description,
    applicationCategory: "Writing",
    operatingSystem: "Windows, macOS, Android, iOS",
    featureList: novelos.features.map((f) => f.title).join(", "),
    offers: {
      "@type": "Offer",
      price: novelos.price.amount,
      priceCurrency: novelos.price.currency,
      url: novelos.url,
      description: "One-time payment, lifetime personal license.",
    },
    author: { "@id": `${site.url}/#organization` },
  },
  {
    "@type": "SoftwareApplication",
    "@id": `${sealqr.url}/#app`,
    name: sealqr.name,
    url: sealqr.url,
    description: sealqr.description,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    featureList: sealqr.features.map((f) => f.title).join(", "),
    offers: [
      {
        "@type": "Offer",
        name: "Free",
        price: sealqr.price.amount,
        priceCurrency: sealqr.price.currency,
        url: sealqr.url,
      },
      {
        "@type": "Offer",
        name: "Pro",
        price: sealqr.pro.amount,
        priceCurrency: sealqr.pro.currency,
        url: sealqr.url,
        description: "Billed yearly. Also $4.99 a month, or $80 once for lifetime.",
      },
    ],
    author: { "@id": `${site.url}/#organization` },
  },
];
---

<Base
  title="Work"
  description="Software made by Taraxa Studio: NovelOS Studio for writers ($45, pay once) and SealQR for dynamic QR codes (free to start), with PixelOS Studio for 2D artists and TypeOS Studio for type foundries in progress."
  schema={schema}
>
  <section class="mx-auto max-w-3xl px-5 pt-12 pb-12 text-center sm:pt-16">
    <h1 class="t-hero">Work</h1>
    <p class="t-body mx-auto mt-5 max-w-xl text-muted-foreground sm:text-lg">
      Our best work, made with care for people who create.
    </p>
  </section>

  <section class="px-3 pb-3" aria-labelledby="novelos">
    <Product product={novelos} />
  </section>

  <section class="px-3 pb-3" aria-labelledby="sealqr">
    <Product product={sealqr} />
  </section>

  <section class="pb-3" aria-labelledby="next">
    <h2 id="next" class="sr-only">Coming next</h2>
    <Tiles />
  </section>
</Base>
