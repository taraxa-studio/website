---
import Base from "@/layouts/Base.astro";
import NovelOS from "@/components/NovelOS.astro";
import Upcoming from "@/components/Upcoming.astro";
import { site } from "@/lib/site";

const novelos = site.products[0];
const schema = [
  {
    "@type": "CollectionPage",
    "@id": `${site.url}/work#page`,
    url: `${site.url}/work`,
    name: "Work",
    isPartOf: { "@id": `${site.url}/#website` },
    about: { "@id": `${site.url}/#organization` },
  },
  {
    "@type": "SoftwareApplication",
    "@id": `${novelos.url}/#app`,
    name: novelos.name,
    url: novelos.url,
    description: novelos.description,
    applicationCategory: "Writing",
    operatingSystem: "Windows, macOS",
    author: { "@id": `${site.url}/#organization` },
  },
];
---

<Base
  title="Work"
  description="Software made by Taraxa Studio: NovelOS Studio for writers, with PixelOS Studio and TypeOS Studio in progress."
  schema={schema}
>
  <section class="mx-auto w-full max-w-[1400px] px-4 pt-14 pb-20 sm:px-6 lg:px-10 lg:pt-20 lg:pb-28">
    <h1 class="display rise text-5xl sm:text-6xl">Work</h1>
    <p class="measure rise mt-6 text-lg leading-relaxed text-muted-foreground sm:text-xl [animation-delay:80ms]">
      One app is out. Two more are on the way. Each one does a single job.
    </p>
    <div class="mt-16 lg:mt-20">
      <NovelOS heading="h2" />
    </div>
    <div class="mt-16 lg:mt-24">
      <h2 class="mb-6 text-sm font-medium text-muted-foreground">Next</h2>
      <Upcoming />
    </div>
  </section>
</Base>
