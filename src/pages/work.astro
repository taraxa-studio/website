---
import Base from "@/layouts/Base.astro";
import Tiles from "@/components/Tiles.astro";
import NovelOS from "@/components/NovelOS.astro";
import { site, novelos } from "@/lib/site";

const schema = [
  {
    "@type": "CollectionPage",
    "@id": `${site.url}/work#page`,
    url: `${site.url}/work`,
    name: "Work",
    isPartOf: { "@id": `${site.url}/#website` },
    about: { "@id": `${site.url}/#organization` },
  },
  {
    "@type": "SoftwareApplication",
    "@id": `${novelos.url}/#app`,
    name: novelos.name,
    url: novelos.url,
    description: novelos.description,
    applicationCategory: "Writing",
    operatingSystem: "Windows, macOS, Android, iOS",
    featureList: novelos.features.map((f) => f.title).join(", "),
    offers: {
      "@type": "Offer",
      price: novelos.price.amount,
      priceCurrency: novelos.price.currency,
      url: novelos.url,
      description: "One-time payment, lifetime personal license.",
    },
    author: { "@id": `${site.url}/#organization` },
  },
];
---

<Base
  title="Work"
  description="Software made by Taraxa Studio: NovelOS Studio for writers ($45, pay once), with PixelOS Studio for 2D artists and TypeOS Studio for type foundries in progress."
  schema={schema}
>
  <section class="mx-auto max-w-3xl px-5 pt-12 pb-12 text-center sm:pt-16">
    <h1 class="t-hero">Work</h1>
    <p class="t-body mx-auto mt-5 max-w-xl text-muted-foreground sm:text-lg">
      A studio for each craft. Writing today, pixel art and type design next.
    </p>
  </section>

  <section class="px-3 pb-3" aria-labelledby="novelos">
    <NovelOS />
  </section>

  <section class="pb-3" aria-labelledby="next">
    <h2 id="next" class="sr-only">Coming next</h2>
    <Tiles />
  </section>
</Base>
