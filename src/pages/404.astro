---
import Base from "@/layouts/Base.astro";
import { buttonVariants } from "@/components/ui/button";
---

<Base title="Page not found" description="This page does not exist.">
  <section class="mx-auto max-w-3xl px-5 pt-24 pb-32 text-center sm:pt-32">
    <h1 class="t-hero">Nothing here.</h1>
    <p class="t-body mt-5 text-muted-foreground sm:text-lg">The page you asked for does not exist.</p>
    <div class="mt-8">
      <a href="/" class={buttonVariants()}>Go home</a>
    </div>
  </section>
</Base>
