---
import Base from "@/layouts/Base.astro";
import Chevron from "@/components/Chevron.astro";
import Tiles from "@/components/Tiles.astro";
import NovelOS from "@/components/NovelOS.astro";
import Founder from "@/components/Founder.astro";
import { buttonVariants } from "@/components/ui/button";
import { Image } from "astro:assets";
import hero from "@/assets/images/dandelion-hero.jpg";
import { site } from "@/lib/site";
---

<Base>
  <!-- Panel 1: hero. Centered copy, then the flower alone on white. -->
  <section class="bg-background" aria-labelledby="hero">
    <div class="mx-auto max-w-3xl px-5 pt-12 pb-10 text-center sm:pt-16 sm:pb-12">
      <h1 id="hero" class="t-hero rise">{site.tagline}</h1>
      <p class="t-sub rise mx-auto mt-4 max-w-2xl [animation-delay:80ms]">{site.intro}</p>
      <div class="rise mt-7 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 [animation-delay:140ms]">
        <a href="/work" class={buttonVariants()}>See our work</a>
        <a href="/about" class={buttonVariants({ variant: "link" })}>About the studio<Chevron /></a>
      </div>
    </div>
    <div class="mx-auto max-w-2xl px-5 pb-6 sm:pb-8">
      <Image
        src={hero}
        alt="A white dandelion seed head on a white background."
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 720px) 672px, 100vw"
        format="webp"
        quality={85}
        class="rise mx-auto w-full max-w-[560px] [animation-delay:200ms]"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <!-- Panel 2: NovelOS Studio. -->
  <section class="px-3 pb-3" aria-labelledby="novelos">
    <NovelOS />
  </section>

  <!-- Panel 3: two tiles for what comes next. -->
  <section class="pb-3" aria-label="Upcoming products">
    <Tiles />
  </section>

  <!-- Panel 4: the promise in one paragraph. -->
  <section class="bg-background" aria-labelledby="how">
    <div class="mx-auto max-w-3xl px-5 py-24 text-center sm:py-32">
      <h2 id="how" class="t-panel">Made to last.</h2>
      <p class="t-statement mx-auto mt-6 max-w-2xl text-muted-foreground">
        Our apps work offline and keep your files on your own computer. You pay once, not every month. Everything you make exports to open formats, so your work still opens even if we are gone.
      </p>
    </div>
  </section>

  <!-- Panel 5: founder. -->
  <section class="px-3 pb-3" aria-labelledby="founder">
    <div class="rounded-[28px] bg-panel px-5 py-20 sm:py-24">
      <h2 id="founder" class="sr-only">Founder</h2>
      <Founder />
    </div>
  </section>
</Base>
