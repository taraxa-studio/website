---
import Base from "@/layouts/Base.astro";
import { CopyEmail } from "@/components/CopyEmail";
import { buttonVariants } from "@/components/ui/button";
import { Image } from "astro:assets";
import { site } from "@/lib/site";

const schema = [
  {
    "@type": "ContactPage",
    "@id": `${site.url}/contact#page`,
    url: `${site.url}/contact`,
    name: "Contact Taraxa Studio",
    isPartOf: { "@id": `${site.url}/#website` },
    about: { "@id": `${site.url}/#organization` },
  },
];
---

<Base
  title="Contact"
  description={`Email Taraxa Studio at ${site.email}. We are based in Indonesia and reply within a few days.`}
  schema={schema}
>
  <section class="mx-auto max-w-3xl px-5 pt-12 pb-14 text-center sm:pt-16 sm:pb-16">
    <h1 class="t-hero">Contact</h1>
    <p class="t-body mx-auto mt-5 max-w-xl text-muted-foreground sm:text-lg">
      Email is the best way to reach us. We read everything and reply within a few days.
    </p>
    <a
      href={`mailto:${site.email}`}
      class="t-tile mt-10 inline-block break-all rounded-sm outline-none hover:underline hover:underline-offset-4 focus-visible:ring-2 focus-visible:ring-ring"
    >
      {site.email}
    </a>
    <div class="mt-7 flex flex-wrap items-center justify-center gap-2">
      <a href={`mailto:${site.email}`} class={buttonVariants()}>Send an email</a>
      <CopyEmail client:idle email={site.email} />
    </div>
  </section>

  <section class="mx-auto max-w-[1024px] px-5 pb-20 sm:px-6 sm:pb-24">
    <Image
      src="/images/dandelion-snow.webp"
      alt="A single dandelion standing in snow."
      width={1600}
      height={2000}
      class="aspect-[4/5] w-full rounded-2xl object-cover sm:aspect-[16/9]"
      loading="eager"
    />
  </section>
</Base>
