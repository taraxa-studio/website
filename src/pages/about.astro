---
import Base from "@/layouts/Base.astro";
import Chevron from "@/components/Chevron.astro";
import Founder from "@/components/Founder.astro";
import { buttonVariants } from "@/components/ui/button";
import { Image } from "astro:assets";
import stem from "@/assets/images/dandelion-stem.jpg";
import dark from "@/assets/images/dandelion-dark.jpg";
import { site } from "@/lib/site";

const schema = [
  {
    "@type": "AboutPage",
    "@id": `${site.url}/about#page`,
    url: `${site.url}/about`,
    name: "About Taraxa Studio",
    isPartOf: { "@id": `${site.url}/#website` },
    about: { "@id": `${site.url}/#organization` },
  },
];
---

<Base
  title="About"
  description="Taraxa Studio is a small software studio based in Indonesia, founded by Ribhararnus Pracutian. The name comes from Taraxacum, the dandelion."
  schema={schema}
>
  <!-- Centered title and two-line intro, as on openai.com/about -->
  <section class="mx-auto max-w-3xl px-5 pt-20 pb-16 text-center sm:pt-24 sm:pb-20">
    <h1 class="t-hero rise">About</h1>
    <p class="t-body rise mx-auto mt-5 max-w-xl text-muted-foreground sm:text-lg [animation-delay:80ms]">
      Taraxa Studio is a small software studio in {site.country}. We make simple apps for people who create.
    </p>
  </section>

  <!-- Text left, rounded image right -->
  <section class="mx-auto grid max-w-[1024px] items-center gap-10 px-5 pb-24 sm:px-6 lg:grid-cols-12 lg:gap-12" aria-labelledby="name">
    <div class="lg:col-span-5">
      <h2 id="name" class="t-tile">The name</h2>
      <p class="t-body mt-5 max-w-md">
        Taraxa comes from Taraxacum, the dandelion. It is a plain plant that spreads by letting go. We like that idea, so it became our mark.
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
        <a href="/work" class={buttonVariants({ variant: "secondary" })}>See our work</a>
        <a href="/contact" class={buttonVariants({ variant: "link" })}>Contact<Chevron /></a>
      </div>
    </div>
    <div class="lg:col-span-7">
      <Image
        src={stem}
        alt="A dandelion with a curved stem, drawn in black on white."
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 580px, 100vw"
        format="webp"
        class="aspect-square w-full rounded-2xl object-cover"
        loading="eager"
      />
    </div>
  </section>

  <!-- Big centered statement -->
  <section class="mx-auto max-w-3xl px-5 py-8 text-center sm:py-12">
    <p class="t-statement">
      We keep each app small so it stays easy to learn and easy to trust.
    </p>
  </section>

  <!-- Full-width rounded photo -->
  <section class="mx-auto max-w-[1024px] px-5 py-16 sm:px-6 sm:py-20">
    <Image
      src={dark}
      alt="A white dandelion seed head on a black background."
      widths={[768, 1280, 1920]}
      sizes="(min-width: 1072px) 976px, 100vw"
      format="webp"
      class="aspect-[4/5] w-full rounded-2xl object-cover object-[50%_60%] sm:aspect-[16/9]"
      loading="lazy"
    />
  </section>

  <!-- Founder -->
  <section class="mx-auto max-w-3xl px-5 pt-4 pb-20 sm:pb-24" aria-labelledby="founder">
    <h2 id="founder" class="t-tile mb-10 text-center">Founder</h2>
    <Founder />
  </section>

  <!-- Gray rounded call to action -->
  <section class="px-3 pb-3">
    <div class="mx-auto flex flex-col items-center rounded-[28px] bg-panel px-6 py-20 text-center sm:py-24">
      <h2 class="t-panel">Say hello.</h2>
      <a href="/contact" class:list={[buttonVariants({ variant: "secondary" }), "mt-8 bg-white hover:bg-white/70"]}>Contact us</a>
    </div>
  </section>
</Base>
