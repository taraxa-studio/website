---
/**
 * Centered founder block in the OpenAI "people" register:
 * avatar, name, role, two gray pill links with icons.
 */
import { Image } from "astro:assets";
import Icon from "@/components/Icon.astro";
import { buttonVariants } from "@/components/ui/button";
import { site } from "@/lib/site";
---

<div class="flex flex-col items-center text-center">
  <span class="ring-beam heartbeat inline-block">
    <Image
      src="/images/ribhararnus.webp"
      alt={site.founder.name}
      width={224}
      height={224}
      class="size-28 rounded-full bg-background object-cover ring-2 ring-background"
      loading="lazy"
    />
  </span>
  <p class="mt-5 text-[21px] font-semibold tracking-tight">{site.founder.name}</p>
  <p class="t-body mt-0.5 text-muted-foreground">Founder. Indie Product Builder</p>
  <div class="mt-5 flex gap-2">
    <a href={site.founder.github} rel="me noopener" target="_blank" class={buttonVariants({ variant: "secondary", size: "sm" })}>
      <Icon name="github" class="size-4" />GitHub
    </a>
    <a href={site.founder.linkedin} rel="me noopener" target="_blank" class={buttonVariants({ variant: "secondary", size: "sm" })}>
      <Icon name="linkedin" class="size-4 text-[#0A66C2]" />LinkedIn
    </a>
  </div>
</div>
