---
/**
 * Centered founder block in the OpenAI "people" register:
 * avatar, name, role, two gray pill links.
 */
import { Image } from "astro:assets";
import avatar from "@/assets/images/ribhararnus.jpg";
import Icon from "@/components/Icon.astro";
import { buttonVariants } from "@/components/ui/button";
import { site } from "@/lib/site";
---

<div class="flex flex-col items-center text-center">
  <Image
    src={avatar}
    alt={site.founder.name}
    width={112}
    height={112}
    densities={[1, 2]}
    class="size-28 rounded-full object-cover"
    loading="lazy"
  />
  <p class="mt-5 text-[21px] font-semibold tracking-tight">{site.founder.name}</p>
  <p class="t-body mt-0.5 text-muted-foreground">Founder</p>
  <div class="mt-5 flex gap-2">
    <a href={site.founder.github} rel="me noopener" target="_blank" class={buttonVariants({ variant: "secondary", size: "sm" })}>
      <Icon name="github" class="size-4" />GitHub
    </a>
    <a href={site.founder.linkedin} rel="me noopener" target="_blank" class={buttonVariants({ variant: "secondary", size: "sm" })}>
      <Icon name="linkedin" class="size-4" />LinkedIn
    </a>
  </div>
</div>
