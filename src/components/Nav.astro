---
/**
 * Top bar. A large mark with the wordmark on the left, two quiet links in the
 * middle, and a single pill on the right (the OpenAI "Try ChatGPT" slot).
 */
import Mark from "@/components/Mark.astro";
import { buttonVariants } from "@/components/ui/button";
import { site } from "@/lib/site";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { label: "Work", href: "/work" },
  { label: "About", href: "/about" },
];
---

<header class="sticky top-0 z-40 bg-background/75 backdrop-blur-xl backdrop-saturate-150">
  <nav aria-label="Main" class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between px-5 sm:px-6">
    <a
      href="/"
      class="group flex items-center gap-2.5 rounded-full outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
      aria-label={`${site.name} home`}
    >
      <Mark class="size-8 shrink-0 transition-transform duration-500 ease-out group-hover:-rotate-12 sm:size-9" />
      <span class="whitespace-nowrap text-[15px] font-semibold tracking-tight max-[359px]:sr-only sm:text-[17px]">{site.name}</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="flex items-center">
        {
          links.map((item) => {
            const active = current === item.href;
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "inline-flex h-9 items-center rounded-full px-2.5 text-[14px] outline-none transition-colors duration-200 hover:bg-secondary focus-visible:ring-2 focus-visible:ring-ring sm:px-3.5",
                    active ? "bg-secondary text-foreground" : "text-foreground/80",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
      <a
        href="/contact"
        aria-current={current === "/contact" ? "page" : undefined}
        class={buttonVariants({ size: "sm", className: "ml-1 h-9 px-3.5 text-[14px] sm:px-4" })}
      >
        Contact
      </a>
    </div>
  </nav>
</header>
