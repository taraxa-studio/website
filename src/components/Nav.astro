---
import Mark from "@/components/Mark.astro";
import { nav, site } from "@/lib/site";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="sticky top-0 z-40 border-b border-border/60 bg-background/80 backdrop-blur-md supports-[backdrop-filter]:bg-background/70">
  <nav
    aria-label="Main"
    class="mx-auto flex h-14 w-full max-w-[1400px] items-center justify-between px-4 sm:px-6 lg:px-10"
  >
    <a
      href="/"
      class="flex items-center gap-2.5 rounded-full text-sm font-medium tracking-tight outline-none focus-visible:ring-2 focus-visible:ring-ring"
      aria-label={`${site.name} home`}
    >
      <Mark class="size-6 shrink-0" />
      <span>{site.name}</span>
    </a>
    <ul class="flex items-center gap-5 sm:gap-8 text-sm">
      {
        nav.map((item) => {
          const active = current === item.href;
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "rounded-full outline-none transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-ring",
                  active ? "text-foreground" : "text-muted-foreground hover:text-foreground",
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
