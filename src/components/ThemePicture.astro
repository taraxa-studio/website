---
/**
 * One <picture> that serves a light image by default and a dark one when the
 * system prefers dark. Only the matching source is downloaded.
 */
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
}

const {
  light,
  dark,
  alt,
  widths = [640, 960, 1280, 1600, 2000],
  sizes = "(min-width: 1024px) 50vw, 100vw",
  class: className,
  loading = "lazy",
  fetchpriority = "auto",
} = Astro.props;

const opts = { widths, format: "webp" as const, quality: 82 };
const l = await getImage({ src: light, ...opts });
const d = await getImage({ src: dark, ...opts });
---

<picture>
  <source media="(prefers-color-scheme: dark)" srcset={d.srcSet.attribute} sizes={sizes} type="image/webp" />
  <source srcset={l.srcSet.attribute} sizes={sizes} type="image/webp" />
  <img
    src={l.src}
    width={l.attributes.width}
    height={l.attributes.height}
    alt={alt}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    class={className}
  />
</picture>
