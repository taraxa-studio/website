---
/**
 * NovelOS Studio panel: logo, name, one line, the platforms it runs on with
 * brand-coloured glyphs, eight short feature blocks, the price, one action.
 * Used on home and work.
 */
import { Image } from "astro:assets";
import Icon from "@/components/Icon.astro";
import { buttonVariants } from "@/components/ui/button";
import { novelos } from "@/lib/site";

interface Props {
  heading?: "h1" | "h2";
}
const { heading = "h2" } = Astro.props;
const Heading = heading;
const domain = novelos.url.replace(/^https?:\/\//, "");
---

<div class="mx-auto flex flex-col items-center rounded-[28px] bg-panel px-5 py-20 text-center sm:px-8 sm:py-24">
  <Image src="/images/novelos-logo.webp" alt="" width={192} height={192} class="size-20 rounded-[22px] shadow-[0_12px_30px_-12px_rgba(0,0,0,0.4)] sm:size-24" loading="lazy" />
  <Heading id="novelos" class="t-panel mt-8">{novelos.name}</Heading>
  <p class="t-sub mt-2">{novelos.short}</p>
  <p class="t-body mx-auto mt-4 max-w-lg text-muted-foreground">{novelos.description}</p>

  <ul class="mt-7 flex flex-wrap items-center justify-center gap-2" aria-label="Runs on">
    {
      novelos.platforms.map((p) => (
        <li class="inline-flex h-9 items-center gap-2 rounded-full bg-background px-3.5 text-sm">
          <Icon name={p.icon} class:list={["size-4", p.color]} title={p.name} />
          <span>{p.name}</span>
          {p.note && <span class="text-muted-foreground">{p.note}</span>}
        </li>
      ))
    }
  </ul>

  <ul class="mx-auto mt-12 grid w-full max-w-4xl gap-x-10 gap-y-8 text-left sm:grid-cols-2" aria-label="What it does">
    {
      novelos.features.map((f) => (
        <li>
          <h3 class="text-[17px] font-semibold tracking-tight">{f.title}</h3>
          <p class="t-body mt-1 text-muted-foreground">{f.body}</p>
        </li>
      ))
    }
  </ul>

  <p class="mt-12">
    <span class="t-tile">{novelos.price.label}</span>
    <span class="t-body ml-2 text-muted-foreground">{novelos.price.note}</span>
  </p>

  <div class="mt-7">
    <a href={novelos.url} rel="noopener" target="_blank" class={buttonVariants()}>Visit {domain}</a>
  </div>
</div>
