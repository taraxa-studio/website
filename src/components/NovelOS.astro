---
/**
 * The NovelOS Studio portfolio block. Heading row on top, the real product
 * screenshot full width beneath it.
 */
import { Image } from "astro:assets";
import logo from "@/assets/images/novelos-logo.webp";
import shot from "@/assets/images/novelos-dark.webp";
import { site } from "@/lib/site";

interface Props {
  heading?: "h2" | "h3";
}
const { heading = "h3" } = Astro.props;
const Heading = heading;
const novelos = site.products[0];
const domain = novelos.url.replace(/^https?:\/\//, "");
---

<article class="grid gap-8 lg:grid-cols-12 lg:gap-10">
  <div class="flex items-start gap-4 lg:col-span-5">
    <Image
      src={logo}
      alt=""
      width={48}
      height={48}
      densities={[1, 2]}
      class="size-12 shrink-0 rounded-xl"
      loading="lazy"
    />
    <div>
      <Heading class="text-2xl font-medium tracking-tight">{novelos.name}</Heading>
      <p class="text-muted-foreground">{novelos.short}</p>
    </div>
  </div>
  <div class="lg:col-span-7">
    <p class="measure text-lg leading-relaxed text-muted-foreground">{novelos.description}</p>
    <p class="mt-4">
      <a
        href={novelos.url}
        rel="noopener"
        target="_blank"
        class="link-quiet rounded-sm text-base font-medium outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        Visit {domain}
      </a>
    </p>
  </div>
  <figure class="lg:col-span-12">
    <Image
      src={shot}
      alt="The NovelOS Studio manuscript editor showing a chapter in focus mode."
      widths={[640, 1024]}
      sizes="(min-width: 1088px) 1024px, 100vw"
      format="webp"
      class="mx-auto aspect-[4/3] w-full max-w-[1024px] rounded-2xl border border-border/60 object-cover object-top"
      loading="lazy"
    />
  </figure>
</article>
