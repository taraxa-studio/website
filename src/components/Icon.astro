---
/**
 * Brand and UI glyphs, inlined so no icon font or extra request is needed.
 * GitHub, Apple, and PWA come from simple-icons. LinkedIn is the standard
 * 24px "in" glyph and Windows is the four-pane logo (simple-icons ships
 * neither). The UI glyphs are lucide paths.
 */
import { siGithub, siApple, siPwa } from "simple-icons";

type Name =
  | "github" | "linkedin" | "apple" | "windows" | "pwa"
  | "mail" | "home" | "grid" | "user" | "check" | "arrow-up-right" | "chevron-right";

interface Props {
  name: Name;
  class?: string;
  title?: string;
}

const { name, class: className = "size-4", title } = Astro.props;

const glyphs: Record<Name, { path: string; fill: boolean; viewBox?: string }> = {
  github: { path: siGithub.path, fill: true },
  apple: { path: siApple.path, fill: true },
  pwa: { path: siPwa.path, fill: true },
  windows: { path: "M3 3h8.5v8.5H3zM12.5 3H21v8.5h-8.5zM3 12.5h8.5V21H3zM12.5 12.5H21V21h-8.5z", fill: true },
  linkedin: {
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
    fill: true,
  },
  mail: { path: "M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm0 3 8 5 8-5", fill: false },
  home: {
    path: "M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z",
    fill: false,
  },
  grid: {
    path: "M4 3h6a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3h6a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 13h6a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-6a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1zM4 13h6a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1z",
    fill: false,
  },
  user: { path: "M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10z", fill: false },
  check: { path: "M20 6 9 17l-5-5", fill: false },
  "arrow-up-right": { path: "M7 17 17 7M8 7h9v9", fill: false },
  "chevron-right": { path: "m9 6 6 6-6 6", fill: false },
};

const g = glyphs[name];
---

<svg
  class={className}
  viewBox={g.viewBox ?? "0 0 24 24"}
  fill={g.fill ? "currentColor" : "none"}
  stroke={g.fill ? "none" : "currentColor"}
  stroke-width={g.fill ? undefined : 1.75}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={title ? "img" : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : "true"}
>
  <path d={g.path}></path>
</svg>
