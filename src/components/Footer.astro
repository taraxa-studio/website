---
/**
 * Brand footer. The mark and wordmark set large on the left, the studio's
 * story in one line, link groups on the right, then a hairline and legal row.
 */
import Mark from "@/components/Mark.astro";
import Icon from "@/components/Icon.astro";
import { site } from "@/lib/site";

const year = new Date().getFullYear();
const groups = [
  {
    title: "Studio",
    links: [
      { label: "Work", href: "/work" },
      { label: "About", href: "/about" },
      { label: "Contact", href: "/contact" },
    ],
  },
  {
    title: "Products",
    links: [
      { label: "NovelOS Studio", href: site.products[0].url, external: true },
      { label: "PixelOS Studio", href: "/work" },
      { label: "TypeOS Studio", href: "/work" },
    ],
  },
];
const social = [
  { label: "GitHub", href: site.github, icon: "github" as const },
  { label: "LinkedIn", href: site.founder.linkedin, icon: "linkedin" as const },
  { label: "Email", href: `mailto:${site.email}`, icon: "mail" as const },
];
---

<footer class="bg-panel">
  <div class="mx-auto w-full max-w-5xl px-5 pt-16 pb-8 sm:px-6 sm:pt-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <a href="/" class="inline-flex items-center gap-4 rounded-full outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" aria-label={`${site.name} home`}>
          <Mark class="size-14 shrink-0 sm:size-16" />
          <span class="t-tile">{site.name}</span>
        </a>
        <p class="t-body mt-5 max-w-sm text-muted-foreground">
          {site.tagline}. Named after the dandelion, made in {site.country}.
        </p>
        <ul class="mt-6 flex gap-2">
          {
            social.map((s) => (
              <li>
                <a
                  href={s.href}
                  rel="me noopener"
                  target={s.href.startsWith("http") ? "_blank" : undefined}
                  aria-label={s.label}
                  title={s.label}
                  class="inline-flex size-10 items-center justify-center rounded-full bg-background text-foreground outline-none transition-colors duration-200 hover:bg-foreground hover:text-background focus-visible:ring-2 focus-visible:ring-ring"
                >
                  <Icon name={s.icon} class="size-[18px]" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="grid grid-cols-2 gap-8 lg:col-span-5 lg:justify-self-end">
        {
          groups.map((g) => (
            <div>
              <h2 class="text-sm font-semibold">{g.title}</h2>
              <ul class="mt-3 space-y-2.5 text-sm text-muted-foreground">
                {g.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      rel={"external" in l && l.external ? "noopener" : undefined}
                      target={"external" in l && l.external ? "_blank" : undefined}
                      class="rounded-sm outline-none transition-colors hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring"
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-2 border-t border-border/70 pt-5 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p>Copyright &copy; {year} {site.name}.</p>
      <p>{site.country}</p>
    </div>
  </div>
</footer>
