---
/**
 * Seed burst on click. The cursor itself is a real CSS cursor image
 * (see global.css), so it is always visible and never lags. Every click
 * releases a puff of dandelion seeds from that point; they drift up, spin
 * a little, and dissolve. Drawn on one fixed canvas so the page itself
 * never re-renders. Skipped under prefers-reduced-motion.
 */
---

<canvas id="seeds" class="pointer-events-none fixed inset-0 z-[60] hidden size-full" aria-hidden="true"></canvas>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canvas = document.getElementById("seeds") as HTMLCanvasElement | null;
  const ctx = canvas?.getContext("2d");

  if (canvas && ctx && !reduced) {
    canvas.classList.remove("hidden");

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(window.innerWidth * dpr);
      canvas.height = Math.floor(window.innerHeight * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener("resize", resize, { passive: true });

    type Seed = {
      x: number; y: number; vx: number; vy: number;
      rot: number; vr: number; life: number; ttl: number; size: number;
    };
    const seeds: Seed[] = [];
    let raf = 0;

    const burst = (x: number, y: number) => {
      const n = 24 + Math.floor(Math.random() * 10);
      for (let i = 0; i < n; i++) {
        const a = Math.random() * Math.PI * 2;
        const sp = 40 + Math.random() * 150;
        seeds.push({
          x, y,
          vx: Math.cos(a) * sp,
          vy: Math.sin(a) * sp - 70,
          rot: Math.random() * Math.PI * 2,
          vr: (Math.random() - 0.5) * 3,
          life: 0,
          ttl: 1.4 + Math.random() * 1,
          size: 7 + Math.random() * 9,
        });
      }
      if (!raf) { last = performance.now(); raf = requestAnimationFrame(tick); }
    };
    window.addEventListener("pointerdown", (e) => burst(e.clientX, e.clientY), { passive: true });

    const drawSeed = (s: Seed, alpha: number) => {
      ctx.save();
      ctx.translate(s.x, s.y);
      ctx.rotate(s.rot);
      ctx.globalAlpha = alpha;
      ctx.strokeStyle = "#1d1d1f";
      ctx.fillStyle = "#1d1d1f";
      ctx.lineWidth = 1;
      ctx.lineCap = "round";
      const r = s.size;
      ctx.beginPath();
      ctx.moveTo(0, r * 0.2);
      ctx.lineTo(0, r * 1.3);
      ctx.stroke();
      ctx.beginPath();
      for (let i = 0; i < 9; i++) {
        const a = -Math.PI / 2 + (i - 4) * (Math.PI / 9);
        ctx.moveTo(0, r * 0.2);
        ctx.lineTo(Math.cos(a) * r, r * 0.2 + Math.sin(a) * r);
      }
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(0, r * 1.3, 1.2, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    };

    let last = performance.now();
    function tick(now: number) {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      const wind = Math.sin(now / 900) * 12;
      for (let i = seeds.length - 1; i >= 0; i--) {
        const s = seeds[i];
        s.life += dt;
        if (s.life >= s.ttl) { seeds.splice(i, 1); continue; }
        s.vx += (wind - s.vx * 0.9) * dt;
        s.vy += (-28 - s.vy * 0.9) * dt;
        s.x += s.vx * dt;
        s.y += s.vy * dt;
        s.rot += s.vr * dt;
        const t = s.life / s.ttl;
        drawSeed(s, t < 0.65 ? 0.9 : 0.9 * (1 - (t - 0.65) / 0.35));
      }
      raf = seeds.length ? requestAnimationFrame(tick) : 0;
    }
  }
</script>
