---
/**
 * Seed burst on click. The cursor is the normal system cursor; only a real
 * click releases seeds: pointer down and up within a few pixels, on
 * something that is not a text field or the navigation, and without a text
 * selection being made. Drags and selections do nothing. Drawn on one fixed canvas so the
 * page never re-renders. Skipped under prefers-reduced-motion.
 */
---

<canvas id="seeds" transition:persist class="pointer-events-none fixed inset-0 z-60 hidden size-full" aria-hidden="true"></canvas>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canvas = document.getElementById("seeds") as HTMLCanvasElement | null;
  const context = canvas?.getContext("2d");

  if (canvas && context && !reduced) {
    const ctx: CanvasRenderingContext2D = context;
    canvas.classList.remove("hidden");

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(window.innerWidth * dpr);
      canvas.height = Math.floor(window.innerHeight * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener("resize", resize, { passive: true });

    type Seed = {
      x: number; y: number; vx: number; vy: number;
      rot: number; vr: number; life: number; ttl: number; size: number;
    };
    const seeds: Seed[] = [];
    let raf = 0;
    let last = 0;

    const burst = (x: number, y: number) => {
      const n = 24 + Math.floor(Math.random() * 10);
      for (let i = 0; i < n; i++) {
        const a = Math.random() * Math.PI * 2;
        const sp = 40 + Math.random() * 150;
        seeds.push({
          x, y,
          vx: Math.cos(a) * sp,
          vy: Math.sin(a) * sp - 70,
          rot: Math.random() * Math.PI * 2,
          vr: (Math.random() - 0.5) * 3,
          life: 0,
          ttl: 1.4 + Math.random() * 1,
          size: 7 + Math.random() * 9,
        });
      }
      if (!raf) { last = performance.now(); raf = requestAnimationFrame(tick); }
    };

    // Only a clean click counts: same spot on down and up, not in a text
    // field, and no selection was made.
    let downX = 0, downY = 0, downAt = 0;
    const isField = (el: EventTarget | null) =>
      el instanceof Element && !!el.closest("input, textarea, select, [contenteditable='true'], #tabbar, header, nav");

    window.addEventListener("pointerdown", (e) => {
      downX = e.clientX; downY = e.clientY; downAt = e.timeStamp;
    }, { passive: true });

    window.addEventListener("pointerup", (e) => {
      if (e.button !== 0 && e.pointerType === "mouse") return;
      if (isField(e.target)) return;
      const moved = Math.hypot(e.clientX - downX, e.clientY - downY) > 6;
      const slow = e.timeStamp - downAt > 600;
      const sel = window.getSelection();
      const selecting = !!sel && !sel.isCollapsed && sel.toString().length > 0;
      if (moved || slow || selecting) return;
      burst(e.clientX, e.clientY);
    }, { passive: true });

    const drawSeed = (s: Seed, alpha: number) => {
      ctx.save();
      ctx.translate(s.x, s.y);
      ctx.rotate(s.rot);
      ctx.globalAlpha = alpha;
      ctx.strokeStyle = "#1d1d1f";
      ctx.fillStyle = "#1d1d1f";
      ctx.lineWidth = 1;
      ctx.lineCap = "round";
      const r = s.size;
      ctx.beginPath();
      ctx.moveTo(0, r * 0.2);
      ctx.lineTo(0, r * 1.3);
      ctx.stroke();
      ctx.beginPath();
      for (let i = 0; i < 9; i++) {
        const a = -Math.PI / 2 + (i - 4) * (Math.PI / 9);
        ctx.moveTo(0, r * 0.2);
        ctx.lineTo(Math.cos(a) * r, r * 0.2 + Math.sin(a) * r);
      }
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(0, r * 1.3, 1.2, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    };

    function tick(now: number) {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      const wind = Math.sin(now / 900) * 12;
      for (let i = seeds.length - 1; i >= 0; i--) {
        const s = seeds[i];
        s.life += dt;
        if (s.life >= s.ttl) { seeds.splice(i, 1); continue; }
        s.vx += (wind - s.vx * 0.9) * dt;
        s.vy += (-28 - s.vy * 0.9) * dt;
        s.x += s.vx * dt;
        s.y += s.vy * dt;
        s.rot += s.vr * dt;
        const t = s.life / s.ttl;
        drawSeed(s, t < 0.65 ? 0.9 : 0.9 * (1 - (t - 0.65) / 0.35));
      }
      raf = seeds.length ? requestAnimationFrame(tick) : 0;
    }
  }
</script>
