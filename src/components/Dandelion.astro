---
/**
 * Dandelion cursor and seed burst.
 *
 * On devices with a fine pointer the system cursor is replaced by a small
 * dandelion seed that follows the pointer. Every click releases a puff of
 * seeds from that point; they drift up and away, spin a little, and fade.
 * Drawn on one fixed canvas so the page itself never re-renders.
 *
 * Honors prefers-reduced-motion: the burst is skipped and the system cursor
 * is left alone.
 */
---

<canvas id="seeds" class="pointer-events-none fixed inset-0 z-[60] hidden size-full" aria-hidden="true"></canvas>
<div id="seed-cursor" class="pointer-events-none fixed top-0 left-0 z-[61] hidden opacity-0 transition-opacity duration-200" aria-hidden="true">
  <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-linecap="round" class="text-foreground">
    <g stroke-width="1.1">
      <path d="M14 15 L14 26.5" />
      <path d="M14 15 L14 4.5" />
      <path d="M14 15 L5.5 8" />
      <path d="M14 15 L22.5 8" />
      <path d="M14 15 L4 15.5" />
      <path d="M14 15 L24 15.5" />
      <path d="M14 15 L7.5 21.5" />
      <path d="M14 15 L20.5 21.5" />
    </g>
    <circle cx="14" cy="15" r="1.6" fill="currentColor" stroke="none" />
  </svg>
</div>

<script>
  const finePointer = window.matchMedia("(pointer: fine)").matches;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const canvas = document.getElementById("seeds") as HTMLCanvasElement | null;
  const cursor = document.getElementById("seed-cursor");
  const ctx = canvas?.getContext("2d");

  if (canvas && ctx && cursor && finePointer && !reduced) {
    document.documentElement.classList.add("seed-cursor");
    canvas.classList.remove("hidden");
    cursor.classList.remove("hidden");

    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(window.innerWidth * dpr);
      canvas.height = Math.floor(window.innerHeight * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener("resize", resize, { passive: true });

    // Cursor follows the pointer with a light lag so it feels like a seed.
    let px = -100, py = -100, cx = -100, cy = -100, raf = 0;
    const move = (e: PointerEvent) => {
      px = e.clientX;
      py = e.clientY;
      if (cx < 0) { cx = px; cy = py; cursor.style.opacity = "1"; }
      if (!raf) raf = requestAnimationFrame(tick);
    };
    window.addEventListener("pointermove", move, { passive: true });
    window.addEventListener("pointerleave", () => cursor.style.opacity = "0");
    window.addEventListener("pointerenter", () => cursor.style.opacity = "1");

    type Seed = {
      x: number; y: number; vx: number; vy: number;
      rot: number; vr: number; life: number; ttl: number; size: number;
    };
    const seeds: Seed[] = [];

    const burst = (x: number, y: number) => {
      const n = 22 + Math.floor(Math.random() * 10);
      for (let i = 0; i < n; i++) {
        const a = Math.random() * Math.PI * 2;
        const sp = 40 + Math.random() * 140;
        seeds.push({
          x, y,
          vx: Math.cos(a) * sp,
          vy: Math.sin(a) * sp - 60,
          rot: Math.random() * Math.PI * 2,
          vr: (Math.random() - 0.5) * 3,
          life: 0,
          ttl: 1.3 + Math.random() * 0.9,
          size: 7 + Math.random() * 8,
        });
      }
      if (!raf) raf = requestAnimationFrame(tick);
    };
    window.addEventListener("pointerdown", (e) => burst(e.clientX, e.clientY), { passive: true });

    const drawSeed = (s: Seed, alpha: number) => {
      ctx.save();
      ctx.translate(s.x, s.y);
      ctx.rotate(s.rot);
      ctx.globalAlpha = alpha;
      ctx.strokeStyle = "#1d1d1f";
      ctx.lineWidth = 0.9;
      ctx.lineCap = "round";
      const r = s.size;
      // stem
      ctx.beginPath();
      ctx.moveTo(0, r * 0.2);
      ctx.lineTo(0, r * 1.3);
      ctx.stroke();
      // pappus: a small fan of hairs
      ctx.beginPath();
      for (let i = 0; i < 9; i++) {
        const a = -Math.PI / 2 + (i - 4) * (Math.PI / 9);
        ctx.moveTo(0, r * 0.2);
        ctx.lineTo(Math.cos(a) * r, r * 0.2 + Math.sin(a) * r);
      }
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(0, r * 1.3, 1.1, 0, Math.PI * 2);
      ctx.fillStyle = "#1d1d1f";
      ctx.fill();
      ctx.restore();
    };

    let last = performance.now();
    function tick(now: number) {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;

      // ease the cursor toward the pointer
      cx += (px - cx) * 0.35;
      cy += (py - cy) * 0.35;
      cursor.style.transform = `translate(${cx - 14}px, ${cy - 15}px)`;

      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      const wind = Math.sin(now / 900) * 12;
      for (let i = seeds.length - 1; i >= 0; i--) {
        const s = seeds[i];
        s.life += dt;
        if (s.life >= s.ttl) { seeds.splice(i, 1); continue; }
        s.vx += (wind - s.vx * 0.9) * dt;
        s.vy += (-28 - s.vy * 0.9) * dt; // drift upward, slow down
        s.x += s.vx * dt;
        s.y += s.vy * dt;
        s.rot += s.vr * dt;
        const t = s.life / s.ttl;
        drawSeed(s, t < 0.7 ? 0.9 : 0.9 * (1 - (t - 0.7) / 0.3));
      }

      const moving = Math.abs(px - cx) > 0.2 || Math.abs(py - cy) > 0.2;
      raf = seeds.length || moving ? requestAnimationFrame(tick) : 0;
    }
  }
</script>

<style is:global>
  html.seed-cursor,
  html.seed-cursor a,
  html.seed-cursor button,
  html.seed-cursor [role="button"] {
    cursor: none;
  }
</style>
