---
/**
 * Floating glass tab bar, after Telegram's Liquid Glass bottom bar
 * (Telegram for iOS, October 2025): a translucent pill that floats over the
 * content, a soft refraction highlight along its top edge, and one rounded
 * "lens" that slides under the active tab. The Telegram UI kit's Tabbar
 * (@telegram-apps/telegram-ui) uses the same shape: icon over label,
 * four to five items, the current one filled.
 *
 * The lens is one element moved with a transform; it glides to whatever
 * tab is hovered and settles back on the current page. With the client
 * router the bar persists between pages, so it also glides on navigation.
 */
import Icon from "@/components/Icon.astro";
import { nav } from "@/lib/site";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const activeIndex = Math.max(0, nav.findIndex((n) => n.href === current));
---

<nav
  id="tabbar"
  aria-label="Main"
  transition:persist
  class="pointer-events-none fixed inset-x-0 bottom-0 z-40 flex justify-center px-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-2 sm:pb-5"
>
  <div
    class="glass pointer-events-auto relative w-full max-w-md rounded-[26px] p-1.5 sm:w-auto"
    data-active={activeIndex}
    style={`--tabs:${nav.length};--active:${activeIndex}`}
  >
    <span id="tab-lens" class="tab-lens" aria-hidden="true"></span>
    <ul class="relative grid" style={`grid-template-columns:repeat(${nav.length},minmax(0,1fr))`}>
      {
        nav.map((item, i) => {
          const active = i === activeIndex;
          return (
            <li>
              <a
                href={item.href}
                data-tab={i}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "relative z-10 flex h-14 flex-col items-center justify-center gap-0.5 rounded-[20px] text-[11px] font-medium tracking-tight outline-none transition-colors duration-300 focus-visible:ring-2 focus-visible:ring-ring sm:h-[54px] sm:w-[92px]",
                  active ? "text-background" : "text-foreground/80 hover:text-foreground",
                ]}
              >
                <Icon name={item.icon} class="size-[22px]" />
                <span>{item.label}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>

<style>
  .tab-lens {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 6px;
    width: calc((100% - 12px) / var(--tabs));
    border-radius: 20px;
    background: var(--foreground);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.25),
      0 6px 18px -8px rgba(0, 0, 0, 0.6);
    transform: translateX(calc(var(--active) * 100%));
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  [data-hover] .tab-lens {
    transform: translateX(calc(var(--hover) * 100%));
  }
  @media (prefers-reduced-motion: reduce) {
    .tab-lens { transition: none; }
  }
</style>

<script>
  // Glide the lens to the hovered tab, settle back on the current page.
  // Re-run after each client-side navigation so the current tab updates.
  const setup = () => {
    const bar = document.querySelector<HTMLElement>("#tabbar > div");
    if (!bar) return;
    const links = Array.from(bar.querySelectorAll<HTMLAnchorElement>("a[data-tab]"));

    const path = window.location.pathname.replace(/\/$/, "") || "/";
    let active = Math.max(0, links.findIndex((a) => a.getAttribute("href") === path));
    bar.style.setProperty("--active", String(active));
    links.forEach((a, i) => {
      const on = i === active;
      a.classList.toggle("text-background", on);
      a.classList.toggle("text-foreground/80", !on);
      a.classList.toggle("hover:text-foreground", !on);
      if (on) a.setAttribute("aria-current", "page"); else a.removeAttribute("aria-current");
    });

    if (!bar.dataset.bound) {
      bar.dataset.bound = "1";
      links.forEach((a, i) => {
        a.addEventListener("pointerenter", (e) => {
          if (e.pointerType !== "mouse") return;
          bar.style.setProperty("--hover", String(i));
          bar.setAttribute("data-hover", "");
          links.forEach((l, j) => l.classList.toggle("text-background", j === i));
        });
      });
      bar.addEventListener("pointerleave", () => {
        bar.removeAttribute("data-hover");
        const cur = Number(bar.style.getPropertyValue("--active") || 0);
        links.forEach((l, j) => l.classList.toggle("text-background", j === cur));
      });
    }
  };
  setup();
  document.addEventListener("astro:page-load", setup);
</script>
