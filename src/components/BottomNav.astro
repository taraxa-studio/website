---
/**
 * Floating glass tab bar, after Telegram's Liquid Glass bottom bar
 * (Telegram for iOS, October 2025): a translucent pill that floats over the
 * content, a soft refraction highlight along its top edge, and one rounded
 * "lens" that slides under the active tab. The Telegram UI kit's Tabbar
 * (@telegram-apps/telegram-ui) uses the same shape: icon over label,
 * four to five items, the current one filled. Icons are Microsoft's
 * Fluent Emoji in the 3D style (MIT, github.com/microsoft/fluentui-emoji),
 * shipped as 72px WebP files in public/icons.
 *
 * The lens is one element moved with a transform. It moves only on a
 * click. The bar is persisted across Astro page navigations, so on each
 * astro:page-load the current tab is recomputed and the lens glides there.
 * On a hard load, the tab you came from is read back from sessionStorage
 * and the lens glides in from it. Hover only darkens the label.
 */
import { Image } from "astro:assets";
import { nav } from "@/lib/site";

const norm = (p: string) => p.replace(/\/+$/, "") || "/";
const current = norm(Astro.url.pathname);
const activeIndex = Math.max(0, nav.findIndex((n) => norm(n.href) === current));
---

<nav
  id="tabbar"
  aria-label="Main"
  transition:persist
  class="pointer-events-none fixed inset-x-0 bottom-0 z-40 flex justify-center px-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-2 sm:pb-5"
>
  <div
    class="glass pointer-events-auto relative w-full max-w-md rounded-[26px] p-1.5 sm:w-auto"
    data-active={activeIndex}
    style={`--tabs:${nav.length};--active:${activeIndex}`}
  >
    <span id="tab-lens" class="tab-lens" aria-hidden="true"></span>
    <ul class="relative grid" style={`grid-template-columns:repeat(${nav.length},minmax(0,1fr))`}>
      {
        nav.map((item, i) => {
          const active = i === activeIndex;
          return (
            <li>
              <a
                href={item.href}
                data-tab={i}
                data-on={active ? "1" : "0"}
                aria-current={active ? "page" : undefined}
                class="tab relative z-10 flex h-14 flex-col items-center justify-center gap-0.5 rounded-[20px] text-[11px] font-medium tracking-tight outline-none transition-colors duration-300 focus-visible:ring-2 focus-visible:ring-ring sm:h-[54px] sm:w-[92px]"
              >
                <Image src={`/icons/${item.icon}.webp`} alt="" width={72} height={72} class="size-6 sm:size-[26px]" data-invert={"invert" in item && item.invert ? "1" : undefined} loading="eager" decoding="async" />
                <span>{item.label}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>

<style>
  .tab-lens {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 6px;
    width: calc((100% - 12px) / var(--tabs));
    border-radius: 20px;
    background: var(--foreground);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.25),
      0 6px 18px -8px rgba(0, 0, 0, 0.6);
    transform: translateX(calc(var(--active) * 100%));
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  /* Unlayered, so it wins over the utility layer: the tab under the lens is
     always white, whether it is the current page or the hovered one. */
  .tab { color: color-mix(in oklch, var(--foreground) 80%, transparent); }
  .tab:hover { color: var(--foreground); }
  .tab[data-on="1"], .tab[data-on="1"]:hover { color: var(--background); }
  /* The silhouette icon is dark; invert it on the dark lens so it stays visible. */
  .tab[data-on="1"] img[data-invert] { filter: invert(1) brightness(1.1); }
  @media (prefers-reduced-motion: reduce) {
    .tab-lens { transition: none; }
  }
</style>

<script>
  const KEY = "taraxa:tab";
  const bar = document.querySelector<HTMLElement>("#tabbar > div");

  const sync = (navigated = false) => {
    if (!bar) return;
    const links = Array.from(bar.querySelectorAll<HTMLAnchorElement>("a[data-tab]"));
    const norm = (p: string) => p.replace(/\/+$/, "") || "/";
    const path = norm(window.location.pathname);
    const active = Math.max(0, links.findIndex((a) => norm(a.getAttribute("href") || "") === path));
    links.forEach((a, i) => {
      a.setAttribute("data-on", i === active ? "1" : "0");
      if (i === active) a.setAttribute("aria-current", "page"); else a.removeAttribute("aria-current");
    });
    const apply = () => bar.style.setProperty("--active", String(active));
    if (navigated) {
      // The persisted bar was just re-inserted; flush styles so the change
      // has a "before" state to transition from, then apply on a fresh frame.
      void bar.offsetWidth;
      requestAnimationFrame(() => requestAnimationFrame(apply));
    } else {
      apply();
    }
    try { sessionStorage.setItem(KEY, String(active)); } catch {}
  };

  // Hard load: start the lens on the tab the visitor came from, then glide.
  if (bar) {
    let from = -1;
    try { from = Number(sessionStorage.getItem(KEY) ?? -1); } catch {}
    const current = Number(bar.dataset.active || 0);
    const lens = bar.querySelector<HTMLElement>("#tab-lens");
    if (lens && from >= 0 && from !== current) {
      lens.style.transition = "none";
      bar.style.setProperty("--active", String(from));
      void lens.offsetWidth;
      lens.style.transition = "";
    }
  }
  sync();
  // Client-side navigation: the bar persists, so just move the lens.
  document.addEventListener("astro:page-load", () => sync(true));
</script>
