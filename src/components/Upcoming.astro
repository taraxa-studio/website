---
import { site } from "@/lib/site";
const upcoming = site.products.filter((p) => p.status === "upcoming");
---

<ul class="divide-y divide-border/60 border-y border-border/60">
  {
    upcoming.map((p) => (
      <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-5">
        <span class="text-lg font-medium tracking-tight">{p.name}</span>
        <span class="text-muted-foreground">{p.short}</span>
        <span class="w-full text-sm text-muted-foreground sm:w-auto">In progress</span>
      </li>
    ))
  }
</ul>
